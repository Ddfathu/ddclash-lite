<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F4F6F9">

    <!-- Header & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DDclash Lite"
                android:textSize="22sp"
                android:textColor="#212529"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Disconnected"
                android:textColor="#6C757D"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Indikator Hasil Ping -->
        <TextView
            android:id="@+id/tvPing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ping: -- ms"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#495057"
            android:background="#E9ECEF"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Tombol Action Bar (Start, Link, Ping) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.2"
            android:text="START VPN"
            android:backgroundTint="#0D6EFD"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnPing"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="0.8"
            android:layout_marginStart="6dp"
            android:text="TEST PING"
            android:backgroundTint="#6F42C1"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnAddConfig"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:text="+ LINK"
            android:backgroundTint="#198754"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Tab Config YAML (Collapsible/Ringkas) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Config YAML Editor:"
        android:textStyle="bold"
        android:textColor="#343A40"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etConfigYaml"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="top|start"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:scrollbars="vertical"
        android:hint="# Konfigurasi YAML akan muncul di sini..."
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <EditText
            android:id="@+id/etDns"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="1.1.1.1, 8.8.8.8"
            android:textSize="12sp"
            android:background="#E9ECEF"
            android:paddingHorizontal="8dp" />

        <Button
            android:id="@+id/btnSaveConfig"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:text="SIMPAN"
            android:textSize="12sp"
            android:backgroundTint="#6C757D"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Terminal Jendela Log Realtime -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Core Mihomo Terminal Logs:"
        android:textStyle="bold"
        android:textColor="#343A40"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/svLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:padding="8dp"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF66"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:text="[System] Menunggu VPN diaktifkan...\n" />
    </ScrollView>
</LinearLayout>
